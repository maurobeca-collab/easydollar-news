# ── EasyDollar News — Environment Variables ──────────────────────
#
# Copy this file to .env.local and fill in your values.
# In Vercel: add these in Project → Settings → Environment Variables.

# ── Translation (required for Portuguese translation) ────────────
# Option A: DeepL Free API — sign up free at https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month. Recommended for best quality.
DEEPL_API_KEY=your_deepl_free_api_key_here

# Option B: MyMemory (fallback, no key needed — uses email for higher quota)
# Register free at https://mymemory.translated.net/
MYMEMORY_EMAIL=your_email@example.com

# ── Site configuration ───────────────────────────────────────────
# Your production domain (used for OG tags and sitemaps)
NEXT_PUBLIC_SITE_URL=https://easydollar-news.pt

# ── News revalidation (seconds) ─────────────────────────────────
# How often to refresh news feeds. 900 = 15 minutes.
NEWS_REVALIDATE_SECONDS=900
